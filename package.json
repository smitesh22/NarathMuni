{
  "name": "narathmuni",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon run-local-index.ts",
    "dev": "nodemon run-local-index.ts",
    "format": "prettier --write \"**/*.js\" && prettier --write \"**/*.ts\"",
    "build": "esbuild run-local-index.ts --bundle --platform=node --target=node20 --outdir=dist --external:aws-sdk",
    "build:start": "node dist/run-local-index.js",
    "migrate:deploy:prod": "export $(cat .env.production | xargs) && npx prisma migrate deploy && npx prisma generate",
    "migrate:deploy:dev": "export $(cat .env.development | xargs) && npx prisma migrate deploy && npx prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.713.0",
    "@google-cloud/vision": "^4.3.3",
