    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/otp-generator": "^4.0.2",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
